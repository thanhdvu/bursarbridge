# mock = in-browser implementation of API contract v1 (no backend needed)
# live = talk to the FastAPI backend at NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_MODE=mock
# Browser calls go to /bbapi, which Next.js rewrites to BB_API_ORIGIN/api (no CORS needed).
NEXT_PUBLIC_API_URL=/bbapi
BB_API_ORIGIN=http://127.0.0.1:8000
