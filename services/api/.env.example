DEMO=1
# Public VM recipe uses PUBLIC_DEMO=1, private Secure-cookie sandboxes and shared budgets.
PUBLIC_DEMO=0
# Limited owner-hosted testing only; permits exactly http://127.0.0.1:8318/v1.
# The Ubuntu VM recipe rejects this proxy and requires a dedicated HTTPS API key.
PUBLIC_LOCAL_PROXY=0
# Leave unset to use the user's default WSL distro; e.g. WSL_DISTRO=Ubuntu-24.04
# WSL_DISTRO=Ubuntu-24.04
# PORT=8000 (or cli dev --port 8010)
LLM_PROVIDER=auto
# auto selects Anthropic when its key is present, then OpenAI, else scripted.
# Restart the API after editing .env. Force scripted for a keyless/offline run.
DATABASE_URL=sqlite:///./bursarbridge.db
DATA_DIR=./runtime
# Defaults work without .env: rpId is a host, origins include exact dev ports.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000,http://localhost:3700
# Each exact allowed Origin selects its own hostname as RP ID. RP_ID above only
# identifies legacy credentials; keep its existing value when adding a new domain.
# Public example: https://bursarbridge.noamofficial.vn,https://bursarbridge.pages.dev
# Optional authenticated Pages proxy. Empty means X-BB-* IP headers are ignored.
# Set privately to the same value used by the Pages worker; never in web env.
PUBLIC_PROXY_SECRET=
# Leave CHAIN_MODE unset to use the local deployment discovered by the launcher.
# CHAIN_MODE=local
FISCO_RPC=http://127.0.0.1:8545
SCREENING_MODE=watchman
WATCHMAN_URL=http://127.0.0.1:8084
# Set these only after real deployment. Never put a private key in Git.
AUDIT_CONTRACT=
CREDENTIAL_CONTRACT=
FISCO_PRIVATE_KEY=
# OpenAI-compatible v1 API root. Leave official default unless using your own proxy.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60
# Optional for compatible reasoning models; leave unset until measured.
# OPENAI_REASONING_EFFORT=low
# Owner's CLIProxy example: OPENAI_BASE_URL=http://127.0.0.1:8318/v1
# OPENAI_MODEL=gpt-6.1-sol
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PUBLIC_LLM_DAILY_CALLS=500
PUBLIC_LLM_HOURLY_CALLS=100
PUBLIC_AGENT_PER_MINUTE=3
PUBLIC_AGENT_PER_HOUR=30
PUBLIC_MAX_SANDBOXES=128
PUBLIC_SANDBOX_IDLE_HOURS=6

# Bootstrap is stateless; these limits apply only at session start.
PUBLIC_NEW_PER_IP_MINUTE=10
PUBLIC_NEW_PER_IP_HOUR=120
PUBLIC_NEW_GLOBAL_HOUR=500
PUBLIC_NEW_GLOBAL_DAY=2000
PUBLIC_SANDBOX_PROTECT_MINUTES=5
