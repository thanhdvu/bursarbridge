# Copy outside the checkout (e.g. /root/bursarbridge.env), chmod 600; never commit.
# Dedicated capped API key only. Disable provider auto-reload; no ChatGPT login proxy.
LLM_PROVIDER=auto
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# No key is valid: deterministic scripted demo, still labelled.
OPENAI_TIMEOUT_SECONDS=20
PUBLIC_LLM_DAILY_CALLS=500
PUBLIC_LLM_HOURLY_CALLS=100
PUBLIC_AGENT_PER_MINUTE=3
PUBLIC_AGENT_PER_HOUR=30
PUBLIC_MAX_SANDBOXES=128
PUBLIC_SANDBOX_IDLE_HOURS=6
# Origin/RP, paths, public mode, FISCO and Watchman are set by the renderer.

# Bootstrap is stateless; these limits apply only at session start.
PUBLIC_NEW_PER_IP_MINUTE=10
PUBLIC_NEW_PER_IP_HOUR=120
PUBLIC_NEW_GLOBAL_HOUR=500
PUBLIC_NEW_GLOBAL_DAY=2000
PUBLIC_SANDBOX_PROTECT_MINUTES=5
