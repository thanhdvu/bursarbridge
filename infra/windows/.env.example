# Copy selected LLM fields into the private live state with live.ps1 install.
OPENAI_BASE_URL=http://127.0.0.1:8318/v1
OPENAI_MODEL=gpt-6.1-sol
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=60
# Shared-network visitors still have private cookie sandboxes and visitor quotas.
PUBLIC_LLM_DAILY_CALLS=300
PUBLIC_LLM_HOURLY_CALLS=60
PUBLIC_AGENT_PER_MINUTE=3
PUBLIC_AGENT_PER_HOUR=30
PUBLIC_MAX_SANDBOXES=128
PUBLIC_SANDBOX_IDLE_HOURS=6

# Bootstrap is stateless; these limits apply only at session start.
PUBLIC_NEW_PER_IP_MINUTE=10
PUBLIC_NEW_PER_IP_HOUR=120
PUBLIC_NEW_GLOBAL_HOUR=500
PUBLIC_NEW_GLOBAL_DAY=2000
PUBLIC_SANDBOX_PROTECT_MINUTES=5
